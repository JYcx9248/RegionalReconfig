{
  "Comment": "Alibaba Cloud (ecs.gn7i-c8g1.2xlarge, one A10 each; the control node a CPU instance): the 2-node capacity C2, the nodes started on the lab server's 2-node warmup snapshot. The lab's ladder.",
  "WorkDir": "/data-ssd/chenxu/work/wiki-c1024",
  "IndexDir": "/data-ssd/chenxu/work/wiki-c1024/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/data-ssd/chenxu/data/wiki-c1024.fbin",
  "Queries": "/data-ssd/chenxu/data/wiki-queries.fbin",
  "GroundTruth": "/data-ssd/chenxu/data/wiki-c1024-gt.ibin",
  "SnapshotDir": "/data-ssd/chenxu/warmupdata/wiki-2nodes",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "NodeResources": {
    "ReadIOPSPerNode": 40000
  },
  "Nodes": 2,
  "InitialNodes": 2,
  "Protocol": "lazy",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 64,
    "N": 200
  },
  "Calibrate": {
    "Rates": [
      50,
      100,
      150,
      200,
      250,
      300,
      350,
      400,
      450
    ],
    "SecondsPerRate": 30
  },
  "GPUs": [
    0
  ],
  "RequireSnapshot": true,
  "Hosts": {
    "Nodes": [
      "192.168.1.11",
      "192.168.1.12"
    ],
    "User": "root",
    "SSHOptions": [
      "-o",
      "StrictHostKeyChecking=accept-new"
    ]
  }
}
