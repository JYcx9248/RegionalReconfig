{
  "Comment": "CloudLab c240g5: 4 -> 8 at 90 s under copy-then-flip, its stream ahead of the queries: every node runs with --peer-reads-first, so an old node serves the stream's reads (RAW_GET) before its own queries' (fusion/read_budget.h). A baseline: how fast copy-then-flip copies under the load when the copy goes first, and what that costs the queries. Everything else is experiment.wiki-c1024-cloudlab-gpu-4to8-copy-then-flip.json's, with the rates the 4to8-v2 runs had (390 q/s, 780 from 60 s: about 0.6 x C4 and 0.8 x C8).",
  "WorkDir": "/data-ssd/chenxu/work/wiki-c1024",
  "IndexDir": "/data-ssd/chenxu/work/wiki-c1024/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/data-ssd/chenxu/data/wiki-c1024.fbin",
  "Queries": "/data-ssd/chenxu/data/wiki-queries.fbin",
  "GroundTruth": "/data-ssd/chenxu/data/wiki-c1024-gt.ibin",
  "SnapshotDir": "/data-ssd/chenxu/warmupdata/wiki-4nodes",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000",
    "--peer-reads-first"
  ],
  "Nodes": 8,
  "InitialNodes": 4,
  "Protocol": "copy-then-flip",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 64,
    "N": 200,
    "Rate": "390",
    "RateSteps": "60:780",
    "RetryForSeconds": 30,
    "DurationSeconds": 360,
    "WarmupSeconds": 30
  },
  "Reconfigurations": [
    {
      "TriggerTimeSeconds": 90,
      "DataNodes": 8
    }
  ],
  "GPUs": [
    0
  ],
  "RequireSnapshot": true,
  "Hosts": {
    "Nodes": [
      "10.10.1.2",
      "10.10.1.3",
      "10.10.1.5",
      "10.10.1.6",
      "10.10.1.7",
      "10.10.1.8",
      "10.10.1.9",
      "10.10.1.1"
    ],
    "User": "ycx9248",
    "SSHOptions": [
      "-o",
      "StrictHostKeyChecking=accept-new"
    ]
  }
}
