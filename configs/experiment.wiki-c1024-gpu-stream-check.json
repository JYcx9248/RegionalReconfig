{
  "Comment": "Raw-stream check (branch raw-stream-parallel): copy-then-flip 2 -> 4 at 30 s under a light load (100 q/s, ~30% of C2 at 40K), so the sources have reads to spare and the copy runs at the stream's own speed. Overrides to compare (stage_raw in reconfigurations.json): {\"RawPath\": \"agent\", \"RawStreams\": 1, \"RawBatchBytes\": 65536} (the stream before 2026-10-09), {\"RawPath\": \"agent\"} (4 x 1 MiB through the agents) and the defaults (4 x 1 MiB data node to data node)",
  "WorkDir": "/netsys/chenxu/work/wiki-c1024",
  "IndexDir": "/netsys/chenxu/work/wiki-c1024/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/netsys/chenxu/data/wiki-c1024.fbin",
  "Queries": "/netsys/chenxu/data/wiki-queries.fbin",
  "GroundTruth": "/netsys/chenxu/data/wiki-c1024-gt.ibin",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "NodeResources": {
    "MemoryMax": "24G",
    "CPUsPerNode": 8,
    "ReadIOPSPerNode": 40000
  },
  "Nodes": 4,
  "InitialNodes": 2,
  "Protocol": "copy-then-flip",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "GPUs": [
    3,
    4,
    5,
    6
  ],
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 64,
    "N": 200,
    "Rate": 100,
    "RetryForSeconds": 30,
    "DurationSeconds": 420,
    "WarmupSeconds": 10
  },
  "Reconfigurations": [
    {
      "TriggerTimeSeconds": 30,
      "DataNodes": 4
    }
  ]
}
