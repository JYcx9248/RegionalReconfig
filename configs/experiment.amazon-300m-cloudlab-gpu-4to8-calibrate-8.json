{
  "Comment": "CloudLab c240g5, Amazon 300M: the 8-node capacity. 8 nodes exist only after a scale-out, so it runs first, without load (copy-then-flip: the rescale returns with every raw vector moved), and the ladder measures the cluster it leaves. NProbe 128 and N 200 are the pilot's (recall 0.85 on its 782K documents) until a recall sweep on this index. StageTimeout 2h: copy-then-flip writes about 100 GB to each new node's S3500, over half an hour, past config.yaml's 30 minutes.",
  "WorkDir": "/data-ssd/chenxu/work/amazon-300m",
  "IndexDir": "/data-ssd/chenxu/work/amazon-300m/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/data-ssd/chenxu/amazon/vec/corpus-300m.i8bin",
  "Queries": "/data-ssd/chenxu/amazon/vec/queries-2m.i8bin",
  "GroundTruth": "/data-ssd/chenxu/amazon/vec/corpus-300m-gt.ibin",
  "GroundTruthStride": 200,
  "SnapshotDir": "/data-ssd/chenxu/warmupdata/amazon-300m-4nodes",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--centroid-ratio",
    "0.01",
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "Nodes": 8,
  "InitialNodes": 4,
  "Protocol": "copy-then-flip",
  "StageTimeout": "2h",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 128,
    "N": 200
  },
  "Calibrate": {
    "Rates": [
      200,
      400,
      600,
      800,
      1000,
      1200,
      1400,
      1600
    ],
    "SecondsPerRate": 30
  },
  "RequireSnapshot": true,
  "Reconfigurations": [
    {
      "TriggerTimeSeconds": 0,
      "DataNodes": 8
    }
  ],
  "GPUs": [
    0
  ],
  "Hosts": {
    "Nodes": [
      "10.10.1.2",
      "10.10.1.3",
      "10.10.1.5",
      "10.10.1.6",
      "10.10.1.7",
      "10.10.1.8",
      "10.10.1.9",
      "10.10.1.1"
    ],
    "User": "ycx9248",
    "SSHOptions": [
      "-o",
      "StrictHostKeyChecking=accept-new"
    ]
  }
}
