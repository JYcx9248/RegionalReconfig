{
  "Comment": "Warmup-reuse check on CloudLab (scripts/cloudlab/profile.py; CPU nodes): experiment.warmup-check-reuse-cluster.json with node1 and node2 as the hosts. The snapshot is made on the lab server by experiment.warmup-check.json; each host gets its snapshot.json and its node's n<i>/, and the control node the whole work directory.",
  "WorkDir": "/netsys/chenxu/work/warmup-check",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/netsys/chenxu/work/warmup-check/data/small-base.u8bin",
  "Queries": "/netsys/chenxu/work/warmup-check/data/small-query.u8bin",
  "GroundTruth": "/netsys/chenxu/work/warmup-check/data/small-gt100.ibin",
  "Partition": {
    "Generator": "range",
    "Partitions": 16
  },
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "Backend": "cpu",
  "Nodes": 2,
  "InitialNodes": 2,
  "MetricsInterval": "500ms",
  "NodeArgs": [
    "--workers",
    "2",
    "--max-nprobe",
    "128",
    "--max-rerank",
    "1000"
  ],
  "Load": {
    "K": 10,
    "NProbe": 64,
    "N": 200
  },
  "RequireSnapshot": true,
  "Calibrate": {
    "Rates": [
      50
    ],
    "SecondsPerRate": 10
  },
  "Hosts": {
    "Nodes": [
      "10.10.1.2",
      "10.10.1.3"
    ],
    "User": "ycx9248",
    "SSHOptions": [
      "-o",
      "StrictHostKeyChecking=accept-new"
    ]
  }
}
