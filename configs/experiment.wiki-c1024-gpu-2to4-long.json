{
  "Comment": "2 -> 4 at 90 s, 1200 s of load: copy-then-flip's flip and recovery inside the run",
  "WorkDir": "/netsys/chenxu/work/wiki-c1024",
  "IndexDir": "/netsys/chenxu/work/wiki-c1024/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/netsys/chenxu/data/wiki-c1024.fbin",
  "Queries": "/netsys/chenxu/data/wiki-queries.fbin",
  "GroundTruth": "/netsys/chenxu/data/wiki-c1024-gt.ibin",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "NodeResources": {
    "MemoryMax": "24G",
    "CPUsPerNode": 8,
    "ReadIOPSPerNode": 40000
  },
  "Nodes": 4,
  "InitialNodes": 2,
  "Protocol": "lazy",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "GPUs": [
    3,
    4,
    5,
    6
  ],
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 64,
    "N": 200,
    "Rate": 210,
    "RateSteps": "60:390",
    "RetryForSeconds": 30,
    "DurationSeconds": 1200,
    "WarmupSeconds": 30
  },
  "Reconfigurations": [
    {
      "TriggerTimeSeconds": 90,
      "DataNodes": 4
    }
  ]
}
