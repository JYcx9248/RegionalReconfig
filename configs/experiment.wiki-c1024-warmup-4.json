{
  "Comment": "The warmup of every wiki-c1024 run that starts on 4 nodes: deploys them and saves the snapshot of their raw vectors those runs then start on (scripts/run_local.py, type: warmup).",
  "Type": "warmup",
  "WorkDir": "/data-ssd/chenxu/work/wiki-c1024",
  "IndexDir": "/data-ssd/chenxu/work/wiki-c1024/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/data-ssd/chenxu/data/wiki-c1024.fbin",
  "Queries": "/data-ssd/chenxu/data/wiki-queries.fbin",
  "GroundTruth": "/data-ssd/chenxu/data/wiki-c1024-gt.ibin",
  "SnapshotDir": "/data-ssd/chenxu/warmupdata/wiki-4nodes",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "NodeResources": {
    "MemoryMax": "24G"
  },
  "InitialNodes": 4,
  "Load": {
    "K": 10,
    "Arrivals": "poisson"
  }
}
