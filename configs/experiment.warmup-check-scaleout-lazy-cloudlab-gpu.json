{
  "Comment": "Cluster smoke test of the GPU backend on CloudLab c240g5 (one P100 each; scripts/cloudlab/profile.py with hosts 8, this test on the first 4), as experiment.warmup-check-scaleout-lazy-cloudlab.json: the warmup check's small index and snapshot, 2 -> 4 at 30 s and back to 2 at 80 s under lazy. Run first in a GPU session: it tests the driver, the build for sm_60 and the GPU path of the cluster runner, not performance.",
  "WorkDir": "/netsys/chenxu/work/warmup-check",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/netsys/chenxu/work/warmup-check/data/small-base.u8bin",
  "Queries": "/netsys/chenxu/work/warmup-check/data/small-query.u8bin",
  "GroundTruth": "/netsys/chenxu/work/warmup-check/data/small-gt100.ibin",
  "Partition": {
    "Generator": "range",
    "Partitions": 16
  },
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "Backend": "gpu",
  "Nodes": 4,
  "InitialNodes": 2,
  "MetricsInterval": "500ms",
  "NodeArgs": [
    "--workers",
    "2",
    "--max-nprobe",
    "128",
    "--max-rerank",
    "1000"
  ],
  "Load": {
    "K": 10,
    "NProbe": 64,
    "N": 200,
    "Rate": 50,
    "RateSteps": "20:100,70:50",
    "RetryForSeconds": 30,
    "DurationSeconds": 130,
    "WarmupSeconds": 10
  },
  "RequireSnapshot": true,
  "Protocol": "lazy",
  "TransferRateBytesPerSec": 0,
  "Reconfigurations": [
    {
      "TriggerTimeSeconds": 30,
      "DataNodes": 4
    },
    {
      "TriggerTimeSeconds": 80,
      "DataNodes": 2
    }
  ],
  "GPUs": [
    0
  ],
  "Hosts": {
    "Nodes": [
      "10.10.1.2",
      "10.10.1.3",
      "10.10.1.5",
      "10.10.1.6"
    ],
    "User": "ycx9248",
    "SSHOptions": [
      "-o",
      "StrictHostKeyChecking=accept-new"
    ]
  }
