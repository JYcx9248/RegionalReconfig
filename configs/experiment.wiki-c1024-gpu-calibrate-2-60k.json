{
  "Comment": "2-node capacity at 60K reads/s per node, for experiment.wiki-c1024-gpu-2to4-60k.json",
  "WorkDir": "/netsys/chenxu/work/wiki-c1024",
  "IndexDir": "/netsys/chenxu/work/wiki-c1024/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/netsys/chenxu/data/wiki-c1024.fbin",
  "Queries": "/netsys/chenxu/data/wiki-queries.fbin",
  "GroundTruth": "/netsys/chenxu/data/wiki-c1024-gt.ibin",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "NodeResources": {
    "MemoryMax": "24G",
    "CPUsPerNode": 8,
    "ReadIOPSPerNode": 60000
  },
  "Nodes": 2,
  "InitialNodes": 2,
  "Protocol": "lazy",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "GPUs": [
    3,
    4,
    5,
    6
  ],
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 64,
    "N": 200
  },
  "Calibrate": {
    "Rates": [
      150,
      300,
      400,
      450,
      500,
      550,
      600,
      700
    ],
    "SecondsPerRate": 30
  }
}
