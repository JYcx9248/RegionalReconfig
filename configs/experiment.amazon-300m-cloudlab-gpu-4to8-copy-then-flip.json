{
  "Comment": "CloudLab c240g5, Amazon 300M: 4 -> 8 at 90 s under copy-then-flip. The copy may outlast the load; the run then keeps what it measured. Set the rates from the two capacities: Rate about 0.6 x C4 (4to8-calibrate-4), RateSteps 60:about 0.8 x C8 (4to8-calibrate-8), the same in every protocol's file. NProbe 128 and N 200 are the pilot's (recall 0.85 on its 782K documents) until a recall sweep on this index. StageTimeout 2h: copy-then-flip writes about 100 GB to each new node's S3500, over half an hour, past config.yaml's 30 minutes.",
  "WorkDir": "/data-ssd/chenxu/work/amazon-300m",
  "IndexDir": "/data-ssd/chenxu/work/amazon-300m/index",
  "EngineBin": "engine/build",
  "GoBin": "bin",
  "Base": "/data-ssd/chenxu/amazon/vec/corpus-300m.i8bin",
  "Queries": "/data-ssd/chenxu/amazon/vec/queries-2m.i8bin",
  "GroundTruth": "/data-ssd/chenxu/amazon/vec/corpus-300m-gt.ibin",
  "GroundTruthStride": 200,
  "SnapshotDir": "/data-ssd/chenxu/warmupdata/amazon-300m-4nodes",
  "Partition": {
    "Generator": "gp",
    "Partitions": 64,
    "KaMinPar": "/netsys/chenxu/tools/gp-build/gp_kaminpar",
    "Threads": 32
  },
  "BuildArgs": [
    "--centroid-ratio",
    "0.01",
    "--pq-m",
    "64",
    "--threads",
    "64"
  ],
  "Placement": "even-reversible-graph",
  "Strategy": "two-phase",
  "MetricsInterval": "500ms",
  "ReadyTimeoutSeconds": 3600,
  "NodeArgs": [
    "--workers",
    "8",
    "--max-nprobe",
    "256",
    "--max-rerank",
    "1000"
  ],
  "NodeResources": {
    "ReadIOPSPerNode": 40000
  },
  "Nodes": 8,
  "InitialNodes": 4,
  "Protocol": "copy-then-flip",
  "StageTimeout": "2h",
  "TransferRateBytesPerSec": 0,
  "Backend": "gpu",
  "Load": {
    "K": 10,
    "Arrivals": "poisson",
    "NProbe": 128,
    "N": 200,
    "Rate": "SET_ME",
    "RateSteps": "60:SET_ME",
    "RetryForSeconds": 30,
    "DurationSeconds": 360,
    "WarmupSeconds": 30
  },
  "Reconfigurations": [
    {
      "TriggerTimeSeconds": 90,
      "DataNodes": 8
    }
  ],
  "GPUs": [
    0
  ],
  "RequireSnapshot": true,
  "Hosts": {
    "Nodes": [
      "10.10.1.2",
      "10.10.1.3",
      "10.10.1.5",
      "10.10.1.6",
      "10.10.1.7",
      "10.10.1.8",
      "10.10.1.9",
      "10.10.1.1"
    ],
    "User": "ycx9248",
    "SSHOptions": [
      "-o",
      "StrictHostKeyChecking=accept-new"
    ]
  }
}
